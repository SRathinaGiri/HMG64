# HMG project build options.
# Uncomment and complete only the options required by this project.
# Keep one option per line.

inc=yes
head=native 

# inc=[yes|no] , incremental mode
# head=[off|full|native|dep] , head=<m> control source header parsing (in incremental build mode)
# <m> can be: native (uses compiler to extract dependencies), full (default, uses simple text parser on the whole file), dep, off
# syslibs=[<libname[s]>] ,   list of libraries as system libraries (before regular libraries)
# libpaths=[paths] ,   list of additional library paths
# libs=[<libname[s]>]
# incpaths=[paths]  , add space separated list of additional header paths (for both Harbour and C)
# instfiles=[files]       
# instpaths=[paths]   
# sources=[source files]  , [ .prg, .c , .cpp]  with cpp=yes
# psources=[source files for plugins]
# gt=gtwin ,   gt=[gtname] , gt=<name> same as -gt<name> option
# gui=<bool> 'yes', 'no' , create GUI/console executable
# run=<bool> 'yes' = -run, 'no' = -run- option
# hbcs=[<.hbc file[s]>] ,  hbcs= embed space separated list of .hbc files. Names without the extension is accepted. These references are processed in place.
# autohbcs=[<.ch>:<.hbc>] 
# prgflags=[Harbour flags]
# cflags=[C compilerflags]
# resflags=[resource compiler flags]
# ldflags=[linker flags] , ldflags= space separated list of values as in -ldflag= option
# pflags=[flags for plugins] , pflags= space separated list of values as in -pflag= option
# requests=[func]   ,      requests= add space separated list of symbols to force link to the build target
# plugins=[plugins]  , plugins= space separated list of hbmk2 plugins to load
# mt=<bool> 'yes', 'no' , link with multi/single-thread Harbour VM
# debug=<bool> 'yes' = -debug, 'no' = -debug- option
# opt=yes  , toggle C compiler optimizations (default: on)
# map=<bool> 'yes' /  'no', create (or not) a map file 
# cpp=[yes|no|def] , force C++/C mode
# warn=[max|yes|low|no|def]
# compr=[yes|no|def|min|max]
# echo=<text>'